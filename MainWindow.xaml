                    </Grid>

                    <Button Style="{StaticResource CyanButton}"
                            Content="Gérer dans Téléchargements"
                            Margin="0,12,0,0"
                            Click="OpenDownloadsCenter_Click"/>

                    <TextBlock x:Name="AiUpscaleStatusText"
                               Text="AI Upscale engine not installed yet."
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>

                

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0"
                          Style="{StaticResource CyanButton}"
                          Content="Gérer dans Téléchargements"
                          Click="OpenDownloadsCenter_Click"/>
                  <Button Grid.Column="2"
                          x:Name="MediaProcessButton"
                          Style="{StaticResource PrimaryButton}"
                          Content="Process media"
                          Click="ProcessMedia_Click"/>
                </Grid>

                <TextBlock x:Name="MediaStatusText"
                           Text="Media engine not checked yet."
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem>
