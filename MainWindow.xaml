                         Foreground="{StaticResource Muted}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0"/>

              <TextBlock Foreground="{StaticResource Muted}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,5,0,0"
                         Text="Targets are intentionally limited to known cache/temp directories: current-user temp, Windows Temp, DirectX shader cache, NVIDIA DXCache, GLCache and NV_Cache. Locked files and inaccessible locations are skipped. Browser data, documents, downloads, registry entries, restore points and Windows Update storage are never touched."/>
            </StackPanel>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
