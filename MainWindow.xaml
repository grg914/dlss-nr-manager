                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               Margin="0,3,0,10"/>

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="AI scale"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
