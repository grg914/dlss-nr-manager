                                Margin="0,5,0,10"
                                SelectedIndex="0" ToolTip="Choose the local AI model used for permanently exported video enhancement.">
                        <ComboBoxItem Content="General / Photo"/>
                        <ComboBoxItem Content="General / Conservative"/>
                        <ComboBoxItem Content="Anime / Illustration"/>
                        <ComboBoxItem Content="Anime Video / Minecraft"/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <CheckBox x:Name="PermanentVideoNrCheck"
