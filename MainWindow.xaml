                          <ComboBoxItem Content="Quick — model-native view / short videos"/>
                          <ComboBoxItem Content="Balanced — full-frame + spatial crops" IsSelected="True"/>
                          <ComboBoxItem Content="Thorough — multi-scale + scene-aware video"/>
