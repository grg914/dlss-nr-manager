        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="PC Update Center"
                             Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Read-only detection for software, Windows, drivers, connected devices, firmware and BIOS"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="PcUpdateScanButton"
                          Style="{StaticResource CyanButton}"
                          Content="Scan PC updates"
                          Click="ScanPcUpdates_Click"/>
                  <Button x:Name="WingetUpdateButton"
                          Style="{StaticResource PrimaryButton}"
                          Content="WinGet update all"
                          Margin="8,0,0,0"
                          Click="WingetUpdateAll_Click"/>
                  <Button Content="Clear scan cache"
                          Margin="8,0,0,0"
                          Click="ClearPcUpdateCache_Click"/>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="PcUpdateStatusText"
                         Text="Not scanned yet."
                         Foreground="{StaticResource Muted}"
                         FontSize="11"
                         TextWrapping="Wrap"
