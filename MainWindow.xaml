              </StackPanel>

              <StackPanel Grid.Column="2">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Output size"
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
