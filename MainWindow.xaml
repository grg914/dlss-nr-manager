                             FontWeight="SemiBold"
                             Margin="0,8,0,0"/>
                  <ComboBox x:Name="FpsTypeBox" Margin="0,5,0,12">
                    <ComboBoxItem Content="FPS only"/>
                    <ComboBoxItem Content="Simple — avg FPS + upscaler" IsSelected="True"/>
                    <ComboBoxItem Content="Detailed"/>
                    <ComboBoxItem Content="Detailed + graph"/>
                    <ComboBoxItem Content="Full"/>
                    <ComboBoxItem Content="Full + graph"/>
                    <ComboBoxItem Content="Reflex timings"/>
                  </ComboBox>

                  <TextBlock Text="Overlay position"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <ComboBox x:Name="FpsPositionBox" Margin="0,5,0,0">
                    <ComboBoxItem Content="Top left" IsSelected="True"/>
                    <ComboBoxItem Content="Top right"/>
                    <ComboBoxItem Content="Bottom left"/>
                    <ComboBoxItem Content="Bottom right"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Target process"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <TextBox x:Name="TargetProcessBox"
                           Margin="0,5,0,12"
                           ToolTip="Leave empty to keep TargetProcessName=auto"/>

                  <CheckBox x:Name="LoadReShadeCheck"
                            Content="Ask OptiScaler to load ReShade64.dll"/>

                  <CheckBox x:Name="InstallReShadeAddonCheck"
                            Content="Install latest ReShade with full add-on support after install/update"
                            Margin="0,8,0,0"/>

                  <CheckBox x:Name="AutoUpdateComponentsCheck"
                            Content="Automatically keep GitHub components up to date"
                            IsChecked="True"
                            Margin="0,8,0,0"/>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource CyanButton}"
                            Content="Install ReShade add-on"
                            Click="InstallReShadeAddon_Click"/>
                    <Button Grid.Column="2"
                            Content="Check component updates"
                            Click="CheckComponentUpdates_Click"/>
                  </Grid>

                  <Button Style="{StaticResource CyanButton}"
                          Content="Apply advanced settings"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Stretch"
                          Click="ApplyAdvanced_Click"/>

                  <Border Background="#0B121A"
                          BorderBrush="#1E2C3A"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="11"
                          Margin="0,12,0,0">
                    <TextBlock Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Text="F10 opens the OptiScaler menu. Cyberpunk 2077 uses dbghelp.dll as its validated recommendation. Leave TargetProcessName empty unless a game requires explicit process filtering."/>
                  </Border>
                </StackPanel>
              </Grid>
            </Expander>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="OptiScaler log" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Latest loader and Neural Rendering output"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,3,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource CyanButton}"
                        Content="Reload log"
                        HorizontalAlignment="Right"
                        Click="ReloadLog_Click"/>
              </DockPanel>

              <Border Background="#070B10"
                      BorderBrush="#1C2A39"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="2">
                <TextBox x:Name="LogBox"
                         Height="245"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         Background="#070B10"
                         BorderThickness="0"
                         Foreground="#B9F5C4"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
              </Border>
            </StackPanel>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border CornerRadius="18"
                  BorderBrush="#233246"
                  BorderThickness="1"
                  Background="{StaticResource HeroBackground}"
                  Padding="22"
                  Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Border Width="84" Height="84"
                      CornerRadius="20"
                      Background="#0B121A"
                      BorderBrush="#28465A"
                      BorderThickness="1"
                      ClipToBounds="True">
                <Image Source="assets/branding/logo.png"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="Fant"
                   SnapsToDevicePixels="True"/>
              </Border>

              <StackPanel Grid.Column="1"
                          Margin="18,2,20,0"
                          VerticalAlignment="Center">
                <TextBlock Text="DLSS NR Manager"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="RTX / DLSS compatibility manager"
                           Foreground="{StaticResource Muted}"
                           FontSize="14"
                           Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Border Background="#102D1C"
                          BorderBrush="#286C3B"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="9,4"
                          Margin="0,0,8,0">
                    <TextBlock x:Name="AppVersionText"
                               Text="Version"
                               Foreground="#9DFFAE"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                  </Border>
                  <Border Background="#0E2630"
                          BorderBrush="#245D70"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="9,4">
                    <TextBlock x:Name="GpuText"
                               Text="Detecting GPU…"
                               Foreground="#9CEBFF"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="GpuCompatibilityText"
                           Text="Checking RTX feature compatibility…"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                <Button x:Name="ManagerUpdateButton"
                        Style="{StaticResource CyanButton}"
                        Content="Update available"
                        Visibility="Collapsed"
                        Margin="0,0,0,8"
                        Click="ManagerUpdate_Click"/>
                <Button Style="{StaticResource CyanButton}"
                        Content="Scan installed games"
                        Click="ScanGames_Click"/>
                <Button Content="Clear cover cache"
                        Margin="0,8,0,0"
                        Click="ClearArtworkCache_Click"/>
                <Button Content="Open diagnostic logs"
                        Margin="0,8,0,0"
                        ToolTip="%LOCALAPPDATA%\DlssNrManager\logs"
                        Click="OpenDiagnosticLogs_Click"/>
                <Button Content="Delete local app data"
                        Margin="0,8,0,0"
                        ToolTip="%LOCALAPPDATA%\DlssNrManager"
                        Click="DeleteLocalAppData_Click"/>
              </StackPanel>
            </Grid>
          </Border></Grid></ScrollViewer></TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>