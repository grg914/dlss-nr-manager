              <TextBlock Foreground="{StaticResource Muted}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0"
                         Text="PC scans remain read-only. The only install action in this panel is WinGet update all, which runs only after explicit confirmation. Driver, Windows Update, firmware and BIOS actions still only open official pages/settings."/>
            </StackPanel>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
