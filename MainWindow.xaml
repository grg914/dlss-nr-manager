                    </Grid>

                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Tile size"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
