<Window x:Class="DlssNrManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DLSS NR Manager"
        Icon="assets/branding/app.ico"
        Width="1440" Height="920"
        MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="10"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{StaticResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Custom title bar -->
    <Border x:Name="TitleBar"
            Grid.Row="0"
            Background="#070A0F"
            BorderBrush="#1B2634"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="14,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
            <Image Source="assets/branding/logo.png"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="Fant"
                   SnapsToDevicePixels="True"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DLSS NR Manager"
                       FontSize="14"
                       FontWeight="SemiBold"/>
            <TextBlock Text="DlssNrManager Menu"
                       Foreground="{StaticResource Muted}"
                       FontSize="9"
                       Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource TitleBarButton}"
                  Content="—"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Minimize_Click"/>
          <Button Style="{StaticResource TitleBarButton}"
                  Content="□"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Maximize_Click"/>
          <Button Style="{StaticResource TitleBarButton}"
                  Content="✕"
                  Foreground="{StaticResource Danger}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="#070B10"
              BorderBrush="#1B2634"
              BorderThickness="0,0,1,0">
        <Grid Margin="12,16,12,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Margin="8,0,8,14">
            <TextBlock Text="DlssNrManager Menu"
                       FontSize="17"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Navigation"
                       Foreground="{StaticResource Muted}"
                       FontSize="10"
                       Margin="0,3,0,0"/>
          </StackPanel>

          <ListBox x:Name="MainMenuList"
                   Grid.Row="1"
                   SelectedIndex="0"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Resources>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="#B7C8D9"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                      <Border x:Name="MenuItemBorder"
                              CornerRadius="9"
                              Padding="{TemplateBinding Padding}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="MenuItemBorder" Property="Background" Value="#0D1824"/>
                          <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="#20364A"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="MenuItemBorder" Property="Background" Value="#102231"/>
                          <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="#2A5873"/>
                          <Setter Property="Foreground" Value="#F4F8FC"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.Resources>

            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="🎮" Width="26"/><TextBlock Text="Jeux &amp; DLSS"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="⛏" Width="26"/><TextBlock Text="Minecraft RTX"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="✨" Width="26"/><TextBlock Text="Media Neural"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Width="26"/><TextBlock Text="Détection IA"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="↻" Width="26"/><TextBlock Text="PC Update Center"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="🧹" Width="26"/><TextBlock Text="PC Cleanup"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="✓" Width="26"/><TextBlock Text="Diagnostics"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="26"/><TextBlock Text="Advanced OptiScaler"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="26"/><TextBlock Text="OptiScaler log"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="☰" Width="26"/><TextBlock Text="Application"/></StackPanel></ListBoxItem>
          </ListBox>

          <Border Grid.Row="2"
                  Background="#0B121A"
                  BorderBrush="#1D2A39"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="10"
                  Margin="0,12,0,0">
            <TextBlock Text="Les options sont séparées par fonction pour éviter une longue page déroulante."
                       Foreground="{StaticResource Muted}"
                       FontSize="10"
                       TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>

      <TabControl Grid.Column="1"
                  SelectedIndex="{Binding SelectedIndex, ElementName=MainMenuList, Mode=OneWay}"
                  Background="{StaticResource AppBackground}"
                  BorderThickness="0">
        <TabControl.Template>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter ContentSource="SelectedContent"/>
            </Border>
          </ControlTemplate>
        </TabControl.Template>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="0.95*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: games -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="430"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                  <TextBlock Text="Game library" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Compatible installations detected on this PC"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,14,0,10"
                        Padding="10,7"
                        Background="#0C121A"
                        BorderBrush="#1F2D3D"
                        BorderThickness="1"
                        CornerRadius="8">
                  <TextBlock x:Name="StatusText"
                             Text="Scanning installed games…"
                             Foreground="{StaticResource Accent}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"/>
                </Border>

                <Border Grid.Row="2"
                        Background="#0A1017"
                        BorderBrush="#1D2A39"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="7">
                  <ListBox x:Name="GameBox"
                           SelectionChanged="GameBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>

                          <Border Grid.Column="0"
                                  Width="52"
                                  Height="72"
                                  CornerRadius="7"
                                  Background="#111A24"
                                  BorderBrush="#26394D"
                                  BorderThickness="1"
                                  ClipToBounds="True">
                            <Grid>
                              <TextBlock Text="GAME"
                                         Foreground="#516176"
                                         FontSize="9"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                              <Image Source="{Binding ArtworkUrl}"
                                     Stretch="UniformToFill"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     SnapsToDevicePixels="True"
                                     RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="2"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#F4F7FB"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#8E9AAD"
                                       FontSize="11">
                              <Run Text="{Binding Platform}"/>
                              <Run Text="  •  "/>
                              <Run Text="{Binding Confidence}"/>
                            </TextBlock>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <TextBlock Grid.Row="3"
                           x:Name="CompatibilityText"
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="0,11,0,0"/>

                <Button Grid.Row="4"
                        Content="Choose folder manually"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Click="SelectGame_Click"/>
              </Grid>
            </Border>

            <!-- Right: target + actions -->
            <StackPanel Grid.Column="2">

              <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Selected target" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Installation path, runtime and package state"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,14"/>

                  <TextBlock Text="Executable folder"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <TextBox x:Name="GamePathBox"
                           Margin="0,5,0,10"
                           IsReadOnly="True"/>

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#0B121A"
                            BorderBrush="#1D2A39"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="11">
                      <StackPanel>
                        <TextBlock Text="Installed package"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"/>
                        <TextBlock x:Name="VersionText"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#0B121A"
                            BorderBrush="#1D2A39"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="11">
                      <StackPanel>
                        <TextBlock Text="DLSSNR runtime"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"/>
                        <TextBlock x:Name="RuntimeText"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            x:Name="SelectRuntimeButton"
                            Style="{StaticResource CyanButton}"
                            Content="Select DLSSNR runtime"
                            Click="SelectRuntime_Click"/>
                    <Button Grid.Column="2"
                            x:Name="DiagnoseButton"
                            Style="{StaticResource CyanButton}"
                            Content="Diagnose game"
                            Click="Diagnose_Click"/>
                  </Grid>

                  <CheckBox x:Name="AutoNvidiaRuntimeCheck"
                            Content="Automatically check NVIDIA Streamline and use an official DLSSNR runtime when NVIDIA publishes one"
                            IsChecked="True"
                            Margin="0,9,0,0"/>

                  <TextBlock x:Name="RuntimePathText"
                             Margin="0,7,0,0"
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             FontSize="11"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Install &amp; configure" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Choose the upstream channel and the DLSS features supported by your RTX GPU"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,14"/>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Release channel"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                      <ComboBox x:Name="ChannelBox"
                                Margin="0,5,0,5"
                                SelectionChanged="ChannelBox_SelectionChanged">
                        <ComboBoxItem Content="Stable" IsSelected="True"/>
                        <ComboBoxItem Content="Prerelease"/>
                      </ComboBox>
                      <TextBlock x:Name="AvailableVersionText"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Neural Rendering preset"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                      <ComboBox x:Name="PresetBox" Margin="0,5,0,5">
                        <ComboBoxItem Content="Quality — 100%" IsSelected="True"/>
                        <ComboBoxItem Content="Balanced — 75%"/>
                        <ComboBoxItem Content="Performance — 50%"/>
                      </ComboBox>
                      <TextBlock Text="1 pass • Natural style"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"/>
                    </StackPanel>
                  </Grid>

                  <CheckBox x:Name="AutoNvidiaResourcesCheck"
                            Content="Add missing official NVIDIA Streamline/DLSS resources to the selected game"
                            IsChecked="True"
                            Margin="0,14,0,0"
                            ToolTip="Downloads the latest official NVIDIA Streamline release and copies only missing SR/FG/Reflex/NR runtime DLLs. Existing game DLLs are never overwritten."/>

                  <Border Background="#26180A"
                          BorderBrush="#8B5A16"
                          BorderThickness="1"
                          CornerRadius="9"
                          Padding="11"
                          Margin="0,14,0,0">
                    <StackPanel>
                      <TextBlock Text="Offline / single-player use only"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="Do not install graphics injection/modification files into multiplayer or anti-cheat-protected games unless the game developer explicitly allows it. Anti-cheat systems can treat injected proxy DLLs as tampering and account sanctions, including bans, are possible."
                                 Foreground="{StaticResource Muted}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Margin="0,4,0,0"/>
                      <TextBlock x:Name="GameSafetyText"
                                 Text="Select a game to run the anti-cheat risk check."
                                 Foreground="{StaticResource Muted}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>

                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="InstallButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Install"
                            Click="Install_Click"/>
                    <Button Grid.Column="2"
                            x:Name="UpdateButton"
                            Style="{StaticResource CyanButton}"
                            Content="Update"
                            Click="Install_Click"/>
                    <Button Grid.Column="4"
                            x:Name="ApplyPresetButton"
                            Content="Apply preset"
                            Click="ApplyPreset_Click"/>
                  </Grid>

                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Restore backup"
                            Click="Restore_Click"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource DangerButton}"
                            Content="Uninstall"
                            Click="Uninstall_Click"/>
                    <Button Grid.Column="4"
                            Content="Refresh"
                            Click="Refresh_Click"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Minecraft Java RTX"
                         Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Minecraft 26.2 • one-click Vulkan path tracing • DLSS Ray Reconstruction • Frame Generation/MFG • Reflex"
                         Style="{StaticResource SectionSubtitle}"
                         Margin="0,4,0,14"/>

              <TextBlock Text="Minecraft instance"
                         Foreground="{StaticResource Muted}"
                         FontSize="11"
                         FontWeight="SemiBold"/>

              <Grid Margin="0,5,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="MinecraftInstanceBox"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="MinecraftInstanceBox_SelectionChanged"/>

                <Button Grid.Column="2"
                        Content="Scan"
                        Click="ScanMinecraft_Click"/>

                <Button Grid.Column="4"
                        Content="Choose folder"
                        Click="ChooseMinecraftFolder_Click"/>
              </Grid>

              <Border Background="#0B121A"
                      BorderBrush="#1D2A39"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="11"
                      Margin="0,0,0,12">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="RTX preflight"
                                 FontWeight="SemiBold"/>
                      <TextBlock x:Name="MinecraftPreflightSummaryText"
                                 Text="Select an instance to run compatibility checks."
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="MinecraftPreflightButton"
                            Content="Run preflight"
                            Click="RunMinecraftPreflight_Click"
                            Margin="12,0,0,0"/>
                  </Grid>

                  <TextBlock x:Name="MinecraftPreflightDetailsText"
                             Text="Checks: NVIDIA RTX GPU, driver, Vulkan RT, Java 25, Minecraft 26.2, Fabric Loader 0.19.3+, renderer conflicts and write access."
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             FontSize="10"
                             Margin="0,9,0,0"/>
                </StackPanel>
              </Border>

              <Border Background="#0B121A"
                      BorderBrush="#1D2A39"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="11"
                      Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Open-source renderer stack"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="Downloads Fabric Installer from the official Fabric Maven, Fabric API/optional mods from Modrinth, and the latest tested Minecraft 26.2 Caustica RTX ScandiCraft build from grg914/Caustica-RTX. No JAR is bundled in DLSS NR Manager."
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             FontSize="11"
                             Margin="0,4,0,8"/>

                  <TextBlock x:Name="MinecraftCausticaBuildText"
                             Text="Checking tested Caustica RTX build…"
                             Foreground="{StaticResource Accent}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Margin="0,0,0,8"/>

                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox x:Name="MinecraftInstallFabricApiCheck"
                                Content="Fabric API (required)"
                                IsChecked="True"
                                IsEnabled="False"
                                Margin="0,0,18,0"/>
                      <CheckBox x:Name="MinecraftAllowPrereleaseCheck"
                                Content="Latest tested Caustica RTX 26.2 build"
                                IsChecked="True"
                                IsEnabled="False"/>
                    </StackPanel>

                    <WrapPanel Margin="0,8,0,0">
                      <CheckBox x:Name="MinecraftPerformancePackCheck"
                                Content="Performance pack without renderer replacement (Lithium + FerriteCore + Krypton + C2ME + BadOptimizations + Dynamic FPS)"
                                IsChecked="True"
                                Margin="0,0,18,6"/>
                      <CheckBox x:Name="MinecraftSpbrCheck"
                                Content="SPBRScandi resource pack"
                                IsChecked="True"
                                Margin="0,0,18,6"/>
                    </WrapPanel>

                    <TextBlock Text="Sodium and Iris are not installed in RTX mode: they replace/modify the rendering pipeline and can conflict with Caustica, which owns the Vulkan/path-traced renderer. The optional performance pack avoids renderer replacement; Caustica is experimental, so mod compatibility is still validated at launch. The default SPBRScandi pack keeps the compatible SPBR LabPBR terrain/material base and adds the validated Scandi sky, End, GUI and visual assets without the terrain textures that caused RT artifacts."
                               Foreground="{StaticResource Warning}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                  </StackPanel>

                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.3*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="1.1*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="MinecraftOneClickInstallButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Install DLSS / RTX"
                            Click="InstallMinecraftOneClick_Click"/>
                    <Button Grid.Column="2"
                            x:Name="MinecraftRestoreOriginalButton"
                            Style="{StaticResource DangerButton}"
                            Content="Restore original"
                            Click="RestoreMinecraftOriginal_Click"/>
                    <Button Grid.Column="4"
                            Content="Open Launcher"
                            Click="OpenMinecraftLauncher_Click"/>
                  </Grid>

                  <TextBlock Foreground="{StaticResource Muted}"
                             FontSize="10"
                             TextWrapping="Wrap"
                             Margin="0,9,0,0"
                             Text="One-click install runs the RTX preflight first, then backs up the instance, forces Minecraft 26.2 to prefer Vulkan, installs/updates Fabric Loader when needed, installs Fabric API + the latest tested Caustica RTX 26.2 build, disables conflicting renderer mods into the backup, and patches the Fabric launcher profile for native access. The Caustica build includes RTX Performance Mode, the native ScandiShader RTX look and capability-gated DLSS Neural Rendering support. Unsupported preflight results block installation; warnings require explicit confirmation."/>
                </StackPanel>
              </Border>

              <Border Background="#0B121A"
                      BorderBrush="#1D2A39"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="11">
                <StackPanel>
                  <TextBlock Text="Local NVIDIA DLSS / Streamline runtime"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="Public NVIDIA binaries are downloaded only from official NVIDIA/DLSS or NVIDIA-RTX/Streamline GitHub releases. DLSS-NR-specific files that NVIDIA has not published are never replaced with renamed or unofficial DLLs; you can still select an official local runtime when you have one."
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             FontSize="11"
                             Margin="0,4,0,10"/>

                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
