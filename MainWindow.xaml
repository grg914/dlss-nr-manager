<Window x:Class="DlssNrManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DLSS NR Manager"
        Icon="assets/branding/app.ico"
        Width="1320" Height="900"
        MinWidth="1080" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="10"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{StaticResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Custom title bar -->
    <Border x:Name="TitleBar"
            Grid.Row="0"
            Background="#070A0F"
            BorderBrush="#1B2634"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="14,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
            <Image Source="assets/branding/logo.png" Stretch="UniformToFill"/>
          </Border>
          <TextBlock Text="DLSS NR Manager"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource TitleBarButton}"
                  Content="—"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Minimize_Click"/>
          <Button Style="{StaticResource TitleBarButton}"
                  Content="□"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Maximize_Click"/>
          <Button Style="{StaticResource TitleBarButton}"
                  Content="✕"
                  Foreground="{StaticResource Danger}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="24">
        <StackPanel>

          <!-- Hero -->
          <Border CornerRadius="18"
                  BorderBrush="#233246"
                  BorderThickness="1"
                  Background="{StaticResource HeroBackground}"
                  Padding="22"
                  Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Border Width="84" Height="84"
                      CornerRadius="20"
                      Background="#0B121A"
                      BorderBrush="#28465A"
                      BorderThickness="1"
                      ClipToBounds="True">
                <Image Source="assets/branding/logo.png" Stretch="UniformToFill"/>
              </Border>

              <StackPanel Grid.Column="1"
                          Margin="18,2,20,0"
                          VerticalAlignment="Center">
                <TextBlock Text="DLSS NR Manager"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="OptiScaler Neural Rendering manager"
                           Foreground="{StaticResource Muted}"
                           FontSize="14"
                           Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Border Background="#102D1C"
                          BorderBrush="#286C3B"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="9,4"
                          Margin="0,0,8,0">
                    <TextBlock x:Name="AppVersionText"
                               Text="Version"
                               Foreground="#9DFFAE"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                  </Border>
                  <Border Background="#0E2630"
                          BorderBrush="#245D70"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="9,4">
                    <TextBlock x:Name="GpuText"
                               Text="Detecting GPU…"
                               Foreground="#9CEBFF"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                <Button x:Name="ManagerUpdateButton"
                        Style="{StaticResource CyanButton}"
                        Content="Update available"
                        Visibility="Collapsed"
                        Margin="0,0,0,8"
                        Click="ManagerUpdate_Click"/>
                <Button Style="{StaticResource CyanButton}"
                        Content="Scan installed games"
                        Click="ScanGames_Click"/>
                <Button Content="Clear cover cache"
                        Margin="0,8,0,0"
                        Click="ClearArtworkCache_Click"/>
                <Button Content="Delete local app data"
                        Margin="0,8,0,0"
                        ToolTip="%LOCALAPPDATA%\DlssNrManager"
                        Click="DeleteLocalAppData_Click"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Main dashboard -->
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="0.95*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: games -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="280"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                  <TextBlock Text="Game library" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Compatible installations detected on this PC"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,14,0,10"
                        Padding="10,7"
                        Background="#0C121A"
                        BorderBrush="#1F2D3D"
                        BorderThickness="1"
                        CornerRadius="8">
                  <TextBlock x:Name="StatusText"
                             Text="Scanning installed games…"
                             Foreground="{StaticResource Accent}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"/>
                </Border>

                <Border Grid.Row="2"
                        Background="#0A1017"
                        BorderBrush="#1D2A39"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="7">
                  <ListBox x:Name="GameBox"
                           SelectionChanged="GameBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>

                          <Border Grid.Column="0"
                                  Width="52"
                                  Height="72"
                                  CornerRadius="7"
                                  Background="#111A24"
                                  BorderBrush="#26394D"
                                  BorderThickness="1"
                                  ClipToBounds="True">
                            <Grid>
                              <TextBlock Text="GAME"
                                         Foreground="#516176"
                                         FontSize="9"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                              <Image Source="{Binding ArtworkUrl}"
                                     Stretch="UniformToFill"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     SnapsToDevicePixels="True"
                                     RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                          </Border>

                          <StackPanel Grid.Column="2"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#F4F7FB"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#8E9AAD"
                                       FontSize="11">
                              <Run Text="{Binding Platform}"/>
                              <Run Text="  •  "/>
                              <Run Text="{Binding Confidence}"/>
                            </TextBlock>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <TextBlock Grid.Row="3"
                           x:Name="CompatibilityText"
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="0,11,0,0"/>

                <Button Grid.Row="4"
                        Content="Choose folder manually"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Click="SelectGame_Click"/>
              </Grid>
            </Border>

            <!-- Right: target + actions -->
            <StackPanel Grid.Column="2">

              <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Selected target" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Installation path, runtime and package state"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,14"/>

                  <TextBlock Text="Executable folder"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <TextBox x:Name="GamePathBox"
                           Margin="0,5,0,10"
                           IsReadOnly="True"/>

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#0B121A"
                            BorderBrush="#1D2A39"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="11">
                      <StackPanel>
                        <TextBlock Text="Installed package"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"/>
                        <TextBlock x:Name="VersionText"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#0B121A"
                            BorderBrush="#1D2A39"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="11">
                      <StackPanel>
                        <TextBlock Text="DLSSNR runtime"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"/>
                        <TextBlock x:Name="RuntimeText"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource CyanButton}"
                            Content="Select DLSSNR runtime"
                            Click="SelectRuntime_Click"/>
                    <Button Grid.Column="2"
                            x:Name="DiagnoseButton"
                            Style="{StaticResource CyanButton}"
                            Content="Diagnose game"
                            Click="Diagnose_Click"/>
                  </Grid>

                  <TextBlock x:Name="RuntimePathText"
                             Margin="0,9,0,0"
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             FontSize="11"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Install &amp; configure" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Choose the upstream channel and Neural Rendering preset"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,14"/>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Release channel"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                      <ComboBox x:Name="ChannelBox"
                                Margin="0,5,0,5"
                                SelectionChanged="ChannelBox_SelectionChanged">
                        <ComboBoxItem Content="Stable" IsSelected="True"/>
                        <ComboBoxItem Content="Prerelease"/>
                      </ComboBox>
                      <TextBlock x:Name="AvailableVersionText"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Text="NR preset"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                      <ComboBox x:Name="PresetBox" Margin="0,5,0,5">
                        <ComboBoxItem Content="Quality — 100%" IsSelected="True"/>
                        <ComboBoxItem Content="Balanced — 75%"/>
                        <ComboBoxItem Content="Performance — 50%"/>
                      </ComboBox>
                      <TextBlock Text="1 pass • Natural style"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11"/>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="InstallButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Install"
                            Click="Install_Click"/>
                    <Button Grid.Column="2"
                            x:Name="UpdateButton"
                            Style="{StaticResource CyanButton}"
                            Content="Update"
                            Click="Install_Click"/>
                    <Button Grid.Column="4"
                            x:Name="ApplyPresetButton"
                            Content="Apply preset"
                            Click="ApplyPreset_Click"/>
                  </Grid>

                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Restore backup"
                            Click="Restore_Click"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource DangerButton}"
                            Content="Uninstall"
                            Click="Uninstall_Click"/>
                    <Button Grid.Column="4"
                            Content="Refresh"
                            Click="Refresh_Click"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- Media -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.95*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="Media Neural Rendering" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Apply DLSS Neural Rendering to an image or video file without modifying a game."
                           Style="{StaticResource SectionSubtitle}"
                           Margin="0,4,0,14"/>

                <TextBlock Text="Source file"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,5,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="MediaSourceBox"
                           IsReadOnly="True"
                           MinHeight="40"/>
                  <Button Grid.Column="2"
                          Style="{StaticResource CyanButton}"
                          Content="Choose image / video"
                          Click="SelectMedia_Click"/>
                </Grid>

                <TextBlock Text="Output folder"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="MediaOutputBox"
                           IsReadOnly="True"
                           MinHeight="40"/>
                  <Button Grid.Column="2"
                          Content="Choose folder"
                          Click="SelectMediaOutput_Click"/>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Output size"
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="MediaScaleBox" Margin="0,5,0,10">
                      <ComboBoxItem Content="Native" IsSelected="True"/>
                      <ComboBoxItem Content="2x"/>
                      <ComboBoxItem Content="4K"/>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Neural style"
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="MediaStyleBox" Margin="0,5,0,10">
                      <ComboBoxItem Content="Default" IsSelected="True"/>
                      <ComboBoxItem Content="Natural"/>
                      <ComboBoxItem Content="Cinematic"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Intensity"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,5,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="MediaIntensitySlider"
                          Minimum="0"
                          Maximum="2"
                          Value="1"
                          TickFrequency="0.1"
                          IsSnapToTickEnabled="False"
                          ValueChanged="MediaIntensitySlider_ValueChanged"
                          VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             x:Name="MediaIntensityText"
                             Text="1.00"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource Accent2}"
                             FontWeight="SemiBold"/>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0"
                          x:Name="MediaSetupButton"
                          Style="{StaticResource CyanButton}"
                          Content="Set up media engine"
                          Click="SetupMedia_Click"/>
                  <Button Grid.Column="2"
                          x:Name="MediaProcessButton"
                          Style="{StaticResource PrimaryButton}"
                          Content="Process with DLSS NR"
                          Click="ProcessMedia_Click"/>
                </Grid>

                <TextBlock x:Name="MediaStatusText"
                           Text="Media engine not checked yet."
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- PC Update Center -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="PC Update Center"
                             Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Read-only detection for software, Windows, drivers, connected devices, firmware and BIOS"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="PcUpdateScanButton"
                          Style="{StaticResource CyanButton}"
                          Content="Scan PC updates"
                          Click="ScanPcUpdates_Click"/>
                  <Button Content="Clear scan cache"
                          Margin="8,0,0,0"
                          Click="ClearPcUpdateCache_Click"/>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="PcUpdateStatusText"
                         Text="Not scanned yet."
                         Foreground="{StaticResource Muted}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,12,0,8"/>

              <Border Background="#0A1017"
                      BorderBrush="#1D2A39"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="7">
                <ListBox x:Name="PcUpdateList"
                         MinHeight="180"
                         MaxHeight="340"
                         SelectionChanged="PcUpdateList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="185"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Kind}"
                                   Foreground="{StaticResource Accent2}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,12,0">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"/>
                          <TextBlock Foreground="{StaticResource Muted}"
                                     FontSize="11"
                                     TextWrapping="Wrap">
                            <Run Text="{Binding CurrentVersion}"/>
                            <Run Text="  →  "/>
                            <Run Text="{Binding AvailableVersion}"/>
                            <Run Text="  •  "/>
                            <Run Text="{Binding Source}"/>
                          </TextBlock>
                          <TextBlock Text="{Binding Details}"
                                     Foreground="{StaticResource Muted}"
                                     FontSize="10"
                                     TextWrapping="Wrap"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding ActionLabel}"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PcUpdateSelectionText"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        x:Name="PcUpdateActionButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Open official page"
                        IsEnabled="False"
                        Click="OpenPcUpdateAction_Click"/>
              </Grid>

              <TextBlock Foreground="{StaticResource Muted}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0"
                         Text="Safety: detection only. DLSS NR Manager never installs software, drivers, Windows updates or firmware from this panel. Actions only open official vendor, Microsoft Store, Windows Update or Microsoft WinGet source pages."/>
            </StackPanel>
          </Border>

          <!-- Diagnostics -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Width="40" Height="40"
                      Background="#102A34"
                      BorderBrush="#245A6B"
                      BorderThickness="1"
                      CornerRadius="10"
                      VerticalAlignment="Top">
                <TextBlock Text="✓"
                           Foreground="{StaticResource Accent2}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>

              <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="Compatibility diagnostics"
                           Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="DiagnosticText"
                           Text="Run Diagnose game to verify renderer signals, OptiScaler load state, DLSSNR runtime and loader conflicts."
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Advanced -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Expander IsExpanded="False">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Advanced OptiScaler"
                             Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Proxy, FPS overlay, process filtering and loader integration"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,3,0,0"/>
                </StackPanel>
              </Expander.Header>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="18"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Proxy DLL"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <ComboBox x:Name="ProxyBox" Margin="0,5,0,12">
                    <ComboBoxItem Content="dbghelp.dll"/>
                    <ComboBoxItem Content="dxgi.dll" IsSelected="True"/>
                    <ComboBoxItem Content="d3d12.dll"/>
                  </ComboBox>

                  <CheckBox x:Name="ShowFpsCheck"
                            Content="Enable OptiScaler FPS overlay"
                            IsChecked="True"/>

                  <TextBlock Text="Overlay detail"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Margin="0,8,0,0"/>
                  <ComboBox x:Name="FpsTypeBox" Margin="0,5,0,12">
                    <ComboBoxItem Content="FPS only"/>
                    <ComboBoxItem Content="Simple — avg FPS + upscaler" IsSelected="True"/>
                    <ComboBoxItem Content="Detailed"/>
                    <ComboBoxItem Content="Detailed + graph"/>
                    <ComboBoxItem Content="Full"/>
                    <ComboBoxItem Content="Full + graph"/>
                    <ComboBoxItem Content="Reflex timings"/>
                  </ComboBox>

                  <TextBlock Text="Overlay position"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <ComboBox x:Name="FpsPositionBox" Margin="0,5,0,0">
                    <ComboBoxItem Content="Top left" IsSelected="True"/>
                    <ComboBoxItem Content="Top right"/>
                    <ComboBoxItem Content="Bottom left"/>
                    <ComboBoxItem Content="Bottom right"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Target process"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <TextBox x:Name="TargetProcessBox"
                           Margin="0,5,0,12"
                           ToolTip="Leave empty to keep TargetProcessName=auto"/>

                  <CheckBox x:Name="LoadReShadeCheck"
                            Content="Ask OptiScaler to load ReShade64.dll"/>

                  <CheckBox x:Name="InstallReShadeAddonCheck"
                            Content="Install latest ReShade with full add-on support after install/update"
                            Margin="0,8,0,0"/>

                  <CheckBox x:Name="AutoUpdateComponentsCheck"
                            Content="Automatically keep GitHub components up to date"
                            IsChecked="True"
                            Margin="0,8,0,0"/>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource CyanButton}"
                            Content="Install ReShade add-on"
                            Click="InstallReShadeAddon_Click"/>
                    <Button Grid.Column="2"
                            Content="Check component updates"
                            Click="CheckComponentUpdates_Click"/>
                  </Grid>

                  <Button Style="{StaticResource CyanButton}"
                          Content="Apply advanced settings"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Stretch"
                          Click="ApplyAdvanced_Click"/>

                  <Border Background="#0B121A"
                          BorderBrush="#1E2C3A"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="11"
                          Margin="0,12,0,0">
                    <TextBlock Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Text="F10 opens the OptiScaler menu. Cyberpunk 2077 uses dbghelp.dll as its validated recommendation. Leave TargetProcessName empty unless a game requires explicit process filtering."/>
                  </Border>
                </StackPanel>
              </Grid>
            </Expander>
          </Border>

          <!-- Log -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="OptiScaler log" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Latest loader and Neural Rendering output"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,3,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource CyanButton}"
                        Content="Reload log"
                        HorizontalAlignment="Right"
                        Click="ReloadLog_Click"/>
              </DockPanel>

              <Border Background="#070B10"
                      BorderBrush="#1C2A39"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="2">
                <TextBox x:Name="LogBox"
                         Height="245"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         Background="#070B10"
                         BorderThickness="0"
                         Foreground="#B9F5C4"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
              </Border>
            </StackPanel>
          </Border>

        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>