<Window x:Class="DlssNrManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DLSS NR Manager" Width="1180" Height="900" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="32" Background="{StaticResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,22">
      <TextBlock Text="DLSS NR Manager" FontSize="34" FontWeight="SemiBold"/>
      <TextBlock Text="OptiScaler Neural Rendering manager for compatible installed games"
                 Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{StaticResource Card}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Game target" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Scanning installed games…"
                           Foreground="{StaticResource Accent}" Margin="0,5,0,0"/>
              </StackPanel>
              <Button Content="Scan installed games" DockPanel.Dock="Right"
                      HorizontalAlignment="Right" Click="ScanGames_Click" Margin="12,0,0,0"/>
            </DockPanel>

            <TextBlock Text="Detected compatible games" Foreground="{StaticResource Muted}"/>
            <ComboBox x:Name="GameBox" Margin="0,5,0,12" Height="40"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="GameBox_SelectionChanged"/>

            <TextBlock x:Name="CompatibilityText" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Target executable folder" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="GamePathBox" Margin="0,5,0,12" IsReadOnly="True"/>
                <TextBlock Text="GPU" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="GpuText" Margin="0,4,0,6"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="RuntimeText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="22,0,0,0">
                <Button Content="Select game folder" Click="SelectGame_Click" Margin="0,0,0,8"/>
                <Button Content="Select DLSSNR runtime" Click="SelectRuntime_Click" Margin="0,0,0,8"/>
                <TextBlock x:Name="RuntimePathText" TextWrapping="Wrap" Width="280"
                           Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Card}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Release channel" FontSize="16" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
              <ComboBox x:Name="ChannelBox" Width="170" SelectionChanged="ChannelBox_SelectionChanged">
                <ComboBoxItem Content="Stable" IsSelected="True"/>
                <ComboBoxItem Content="Prerelease"/>
              </ComboBox>
              <TextBlock x:Name="AvailableVersionText" VerticalAlignment="Center"
                         Margin="14,0,0,0" Foreground="{StaticResource Muted}"/>
            </StackPanel>

            <TextBlock Text="Neural Rendering preset" FontSize="16" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
              <ComboBox x:Name="PresetBox" Width="220">
                <ComboBoxItem Content="Quality — 100%" IsSelected="True"/>
                <ComboBoxItem Content="Balanced — 75%"/>
                <ComboBoxItem Content="Performance — 50%"/>
              </ComboBox>
              <TextBlock Text="1 pass • Natural style • applied to any compatible game"
                         VerticalAlignment="Center" Margin="14,0,0,0"
                         Foreground="{StaticResource Muted}"/>
            </StackPanel>

            <WrapPanel>
              <Button x:Name="InstallButton" Content="Install" Click="Install_Click"/>
              <Button x:Name="UpdateButton" Content="Update" Click="Install_Click"/>
              <Button x:Name="ApplyPresetButton" Content="Apply preset" Click="ApplyPreset_Click"/>
              <Button Content="Restore backup" Click="Restore_Click"/>
              <Button Content="Uninstall" Click="Uninstall_Click"/>
              <Button Content="Refresh" Click="Refresh_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Expander Header="Advanced" Background="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="Proxy DLL" Foreground="{StaticResource Muted}"/>
            <ComboBox x:Name="ProxyBox" Width="220" HorizontalAlignment="Left" Margin="0,5,0,10">
              <ComboBoxItem Content="dbghelp.dll"/>
              <ComboBoxItem Content="dxgi.dll" IsSelected="True"/>
              <ComboBoxItem Content="d3d12.dll"/>
            </ComboBox>
            <TextBlock Text="dxgi.dll is the generic first choice. Cyberpunk 2077 uses dbghelp.dll as its validated recommendation. Existing loaders are never overwritten silently."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
        </Expander>

        <Border Background="{StaticResource Card}" CornerRadius="14" Padding="20">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="OptiScaler log" FontSize="16" FontWeight="SemiBold"/>
              <Button Content="Reload log" DockPanel.Dock="Right"
                      HorizontalAlignment="Right" Click="ReloadLog_Click"/>
            </DockPanel>
            <TextBox x:Name="LogBox" Height="260" IsReadOnly="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>