                          BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                    <StackPanel>
                      <TextBlock Text="Versions officielles des outils" FontWeight="SemiBold" Margin="0,0,0,6"/>
                      <TextBlock Text="Comparer les dépôts officiels aux sources suivies (sans installation automatique)."
                                 Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                      <Button x:Name="CheckOfficialUpstreamUpdatesButton"
                              Content="Vérifier versions officielles"
                              Click="CheckOfficialUpstreamUpdates_Click" Margin="0,0,0,8"/>
                      <ListBox x:Name="OfficialUpdateList" Height="160"
                               SelectionChanged="OfficialUpdateList_SelectionChanged"/>
                      <TextBlock x:Name="OfficialUpdateDetailsText"
                                 Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                      <Button x:Name="OpenOfficialUpstreamButton" Content="Voir le dépôt officiel"
                              Click="OpenOfficialUpstream_Click" IsEnabled="False"/>
                      <TextBlock x:Name="OfficialUpdateStatusText" Text="Contrôle à la demande uniquement."
                                 Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>

                  <Border Background="#0B121A"
                          BorderBrush="#1E2C3A"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="10"
                          Margin="0,16,0,0">
                    <StackPanel>
                      <TextBlock Text="Règles"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,5"/>
                      <TextBlock Text="• Plus de 1 Go : confirmation obligatoire avant téléchargement.&#x0a;• Gros modèles : taille totale illimitée côté app, transport en chunks GitHub.&#x0a;• SHA-256 vérifié avant installation.&#x0a;• Suppression locale possible à tout moment."
                                 Foreground="{StaticResource Muted}"
                                 FontSize="10"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="PC Update Center"
                             Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Read-only detection for software, Windows, drivers, connected devices, firmware and BIOS"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="PcUpdateScanButton"
                          Style="{StaticResource CyanButton}"
                          Content="Scan PC updates"
                          Click="ScanPcUpdates_Click"/>
                  <Button x:Name="WingetUpdateButton"
                          Style="{StaticResource PrimaryButton}"
                          Content="WinGet update all"
                          Margin="8,0,0,0"
                          Click="WingetUpdateAll_Click"/>
                  <Button Content="Clear scan cache"
                          Margin="8,0,0,0"
                          Click="ClearPcUpdateCache_Click"/>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="PcUpdateStatusText"
                         Text="Not scanned yet."
                         Foreground="{StaticResource Muted}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,12,0,8"/>

              <Border Background="#0A1017"
                      BorderBrush="#1D2A39"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="7">
                <ListBox x:Name="PcUpdateList"
                         MinHeight="180"
                         MaxHeight="340"
                         SelectionChanged="PcUpdateList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="185"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Kind}"
                                   Foreground="{StaticResource Accent2}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,12,0">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"/>
                          <TextBlock Foreground="{StaticResource Muted}"
                                     FontSize="11"
                                     TextWrapping="Wrap">
                            <Run Text="{Binding CurrentVersion}"/>
                            <Run Text="  →  "/>
                            <Run Text="{Binding AvailableVersion}"/>
                            <Run Text="  •  "/>
                            <Run Text="{Binding Source}"/>
                          </TextBlock>
                          <TextBlock Text="{Binding Details}"
                                     Foreground="{StaticResource Muted}"
                                     FontSize="10"
                                     TextWrapping="Wrap"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding ActionLabel}"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PcUpdateSelectionText"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        x:Name="PcUpdateActionButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Open official page"
                        IsEnabled="False"
                        Click="OpenPcUpdateAction_Click"/>
              </Grid>

              <TextBlock Foreground="{StaticResource Muted}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0"
                         Text="PC scans remain read-only. The only install action in this panel is WinGet update all, which runs only after explicit confirmation. Driver, Windows Update, firmware and BIOS actions still only open official pages/settings."/>
            </StackPanel>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="PC Cleanup"
                             Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Analyze and clean safe Windows temporary files, shell caches and GPU shader caches"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="PcCleanupAnalyzeButton"
                          Style="{StaticResource CyanButton}"
                          Content="Analyze caches"
                          Click="AnalyzePcCleanup_Click"/>
                  <Button x:Name="PcCleanupCleanButton"
                          Style="{StaticResource PrimaryButton}"
                          Content="Clean selected"
                          Margin="8,0,0,0"
                          Click="CleanPcCleanup_Click"/>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="PcCleanupStatusText"
                         Text="Select the cache groups to analyze or clean."
                         Foreground="{StaticResource Muted}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,12,0,8"/>

              <Border Background="#0A1017"
                      BorderBrush="#1D2A39"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="7">
                <ItemsControl x:Name="PcCleanupList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#182432"
                              BorderThickness="0,0,0,1"
                              Padding="7,9">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                          </Grid.ColumnDefinitions>

                          <CheckBox Grid.Column="0"
                                    ToolTip="{Binding Details}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>

                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Details}"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                          </StackPanel>

                          <TextBlock Grid.Column="2"
                                     Text="{Binding SizeText}"
                                     Foreground="{StaticResource Accent2}"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <TextBlock x:Name="PcCleanupTotalText"
                         Text="Analyzed total: 0 B"
                         Foreground="{StaticResource Muted}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0"/>

              <TextBlock Foreground="{StaticResource Muted}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,5,0,0"
                         Text="Targets are intentionally limited to known rebuildable cache/temp locations: current-user temp, Windows Temp, Windows thumbnail/icon cache, DirectX shader cache and NVIDIA/AMD/Intel GPU caches. Locked files and inaccessible locations are skipped. Browser data, documents, downloads, registry entries, restore points, Prefetch, WinSxS and Windows Update storage are never touched."/>

              <Border Height="1"
                      Background="#1D2A39"
                      Margin="0,18,0,16"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="Windows system repair"
                             FontWeight="SemiBold"
                             FontSize="13"/>
                  <TextBlock Text="Run DISM RestoreHealth, then SFC /scannow with administrator rights"
                             Foreground="{StaticResource Muted}"
                             FontSize="10"
                             TextWrapping="Wrap"
                             Margin="0,4,18,0"/>
                </StackPanel>

                <Button x:Name="WindowsRepairButton"
                        Grid.Column="1"
                        Style="{StaticResource CyanButton}"
                        Content="Run DISM + SFC"
                        Click="RunWindowsRepair_Click"/>
              </Grid>

              <TextBlock x:Name="WindowsRepairStatusText"
                         Text="No repair has been run in this session."
                         Foreground="{StaticResource Muted}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0"/>

              <TextBlock Foreground="{StaticResource Muted}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0"
                         Text="This repair action does not delete personal files. It requests UAC, runs DISM /Online /Cleanup-Image /RestoreHealth first, then SFC /scannow in a visible elevated PowerShell window."/>
            </StackPanel>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Width="40" Height="40"
                      Background="#102A34"
                      BorderBrush="#245A6B"
                      BorderThickness="1"
                      CornerRadius="10"
                      VerticalAlignment="Top">
                <TextBlock Text="✓"
                           Foreground="{StaticResource Accent2}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>

              <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="Compatibility diagnostics"
                           Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="DiagnosticText"
                           Text="Run Diagnose game to verify renderer signals, OptiScaler load state, DLSSNR runtime and loader conflicts."
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <Button x:Name="ExportDiagnosticsButton"
                        Style="{StaticResource CyanButton}"
                        Content="Save support bundle"
                        HorizontalAlignment="Left"
                        Margin="0,14,0,0"
                        ToolTip="Exports sanitized manager/game diagnostics to a ZIP you choose."
                        Click="ExportDiagnostics_Click"/>
              </StackPanel>
            </Grid>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Expander IsExpanded="True">
              <Expander.Header>
                <StackPanel>
                  <TextBlock Text="Advanced OptiScaler"
                             Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Proxy, FPS overlay, process filtering and loader integration"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,3,0,0"/>
                </StackPanel>
              </Expander.Header>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="18"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Proxy DLL"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <ComboBox x:Name="ProxyBox" Margin="0,5,0,12" ToolTip="Choose the loader DLL name appropriate for the selected game's graphics API.">
                    <ComboBoxItem Content="dbghelp.dll"/>
                    <ComboBoxItem Content="dxgi.dll" IsSelected="True"/>
                    <ComboBoxItem Content="d3d12.dll"/>
                  </ComboBox>

                  <CheckBox x:Name="ShowFpsCheck"
                            Content="Enable OptiScaler FPS overlay"
                            IsChecked="True" ToolTip="Show OptiScaler's in-game FPS overlay when its hook is active."/>

                  <TextBlock Text="Overlay detail"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Margin="0,8,0,0"/>
                  <ComboBox x:Name="FpsTypeBox" Margin="0,5,0,12" ToolTip="Choose which performance metrics appear in the OptiScaler overlay.">
                    <ComboBoxItem Content="FPS only"/>
                    <ComboBoxItem Content="Simple — avg FPS + upscaler" IsSelected="True"/>
                    <ComboBoxItem Content="Detailed"/>
                    <ComboBoxItem Content="Detailed + graph"/>
                    <ComboBoxItem Content="Full"/>
                    <ComboBoxItem Content="Full + graph"/>
                    <ComboBoxItem Content="Reflex timings"/>
                  </ComboBox>

                  <TextBlock Text="Overlay position"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <ComboBox x:Name="FpsPositionBox" Margin="0,5,0,0" ToolTip="Choose the on-screen location of the OptiScaler performance overlay.">
                    <ComboBoxItem Content="Top left" IsSelected="True"/>
                    <ComboBoxItem Content="Top right"/>
                    <ComboBoxItem Content="Bottom left"/>
                    <ComboBoxItem Content="Bottom right"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Target process"
                             Foreground="{StaticResource Muted}"
                             FontSize="11"
                             FontWeight="SemiBold"/>
                  <TextBox x:Name="TargetProcessBox"
                           Margin="0,5,0,12"
                           ToolTip="Leave empty to keep TargetProcessName=auto"/>

                  <CheckBox x:Name="LoadReShadeCheck"
                            Content="Ask OptiScaler to load ReShade64.dll" ToolTip="Ask the OptiScaler loader to start ReShade64.dll if it is installed."/>

                  <CheckBox x:Name="InstallReShadeAddonCheck"
                            Content="Install latest ReShade with full add-on support after install/update"
                            Margin="0,8,0,0" ToolTip="Offer ReShade installation with add-on support after the game update."/>

                  <CheckBox x:Name="AutoUpdateComponentsCheck"
                            Content="Automatically keep GitHub components up to date"
                            IsChecked="False"
                            Checked="AutoUpdateComponents_Changed"
                            Unchecked="AutoUpdateComponents_Changed"
                            Margin="0,8,0,0" ToolTip="Allow supported manager-owned components to be refreshed on app startup."/>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource CyanButton}"
                            Content="Install ReShade add-on"
                            Click="InstallReShadeAddon_Click"/>
                    <Button Grid.Column="2"
                            Content="Check component updates"
                            Click="CheckComponentUpdates_Click"/>
                  </Grid>

                  <Button Style="{StaticResource CyanButton}"
                          Content="Apply advanced settings"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Stretch"
                          Click="ApplyAdvanced_Click"/>

                  <Border Background="#0B121A"
                          BorderBrush="#1E2C3A"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="11"
                          Margin="0,12,0,0">
                    <TextBlock Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Text="F10 opens the OptiScaler menu. Cyberpunk 2077 uses dbghelp.dll as its validated recommendation. Leave TargetProcessName empty unless a game requires explicit process filtering."/>
                  </Border>
                </StackPanel>
              </Grid>
            </Expander>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="OptiScaler log" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Latest loader and Neural Rendering output"
                             Style="{StaticResource SectionSubtitle}"
                             Margin="0,3,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource CyanButton}"
                        Content="Reload log"
                        HorizontalAlignment="Right"
                        Click="ReloadLog_Click"/>
              </DockPanel>

              <Border Background="#070B10"
                      BorderBrush="#1C2A39"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="2">
                <TextBox x:Name="LogBox"
                         Height="245"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         Background="#070B10"
                         BorderThickness="0"
                         Foreground="#B9F5C4"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
              </Border>
            </StackPanel>
          </Border></Grid></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24"><Border CornerRadius="18"
                  BorderBrush="#233246"
                  BorderThickness="1"
                  Background="{StaticResource HeroBackground}"
                  Padding="22"
                  Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Border Width="84" Height="84"
                      CornerRadius="20"
                      Background="#0B121A"
                      BorderBrush="#28465A"
                      BorderThickness="1"
                      ClipToBounds="True">
                <Image Source="assets/branding/logo.png"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="Fant"
                   SnapsToDevicePixels="True"/>
              </Border>

              <StackPanel Grid.Column="1"
                          Margin="18,2,20,0"
                          VerticalAlignment="Center">
                <TextBlock Text="DLSS NR Manager"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="RTX / DLSS compatibility manager"
                           Foreground="{StaticResource Muted}"
                           FontSize="14"
                           Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Border Background="#102D1C"
                          BorderBrush="#286C3B"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="9,4"
                          Margin="0,0,8,0">
                    <TextBlock x:Name="AppVersionText"
                               Text="Version"
                               Foreground="#9DFFAE"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                  </Border>
                  <Border Background="#0E2630"
                          BorderBrush="#245D70"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="9,4">
                    <TextBlock x:Name="GpuText"
                               Text="Detecting GPU…"
                               Foreground="#9CEBFF"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="GpuCompatibilityText"
                           Text="Checking RTX feature compatibility…"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                <TextBlock Text="Language"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="LanguageSelector"
                          Width="170"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,12"
                          SelectionChanged="LanguageSelector_SelectionChanged" ToolTip="Change the application interface language between French and English.">
                  <ComboBoxItem Content="Français" Tag="fr"/>
                  <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>

                <Button x:Name="ManagerCheckUpdateButton"
                        Style="{StaticResource CyanButton}"
                        Content="Check for app updates"
                        Margin="0,0,0,8"
                        Click="ManagerCheckUpdate_Click"/>
                <Button x:Name="ManagerUpdateButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Update available"
                        Visibility="Collapsed"
                        Margin="0,0,0,8"
                        Click="ManagerUpdate_Click"/>
                <Button x:Name="SoftwareRenderingButton"
                        Content="Use software UI rendering"
                        Margin="0,0,0,8"
                        Click="ToggleSoftwareRendering_Click"/>
                <Button Style="{StaticResource CyanButton}"
                        Content="Scan installed games"
                        Click="ScanGames_Click"/>
                <Button Content="Clear cover cache"
                        Margin="0,8,0,0"
                        Click="ClearArtworkCache_Click"/>
                <Button Content="Open diagnostic logs"
                        Margin="0,8,0,0"
                        ToolTip="%LOCALAPPDATA%\DlssNrManager\logs"
                        Click="OpenDiagnosticLogs_Click"/>
                <Button Content="Delete local app data"
                        Margin="0,8,0,0"
                        ToolTip="%LOCALAPPDATA%\DlssNrManager"
                        Click="DeleteLocalAppData_Click"/>
              </StackPanel>
            </Grid>
          </Border></Grid></ScrollViewer></TabItem>

        <!-- Hardware profile tab is appended to preserve all existing menu indices. -->
        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
              <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Hardware &amp; Profiles" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="Read-only hardware detection and capability-safe preferences"
                             Style="{StaticResource SectionSubtitle}" Margin="0,4,0,18"/>
                  <TextBlock Text="Hardware profile" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <ComboBox x:Name="HardwareProfileBox" SelectedIndex="0"
                            MaxWidth="500" HorizontalAlignment="Left"
                            SelectionChanged="HardwareProfile_Changed"
                            ToolTip="AUTO detects your actual GPU and CPU. A manual preset never unlocks unsupported hardware features.">
                    <ComboBoxItem Content="AUTO"/>
                    <ComboBoxItem Content="RTX 5060 Ti 16GB + Ryzen 7 9700X"/>
                  </ComboBox>
                  <CheckBox x:Name="HardwareCompatibleCheck" Margin="0,15,0,10"
                            Content="Compatible mode"
                            Checked="HardwareProfile_Changed"
                            Unchecked="HardwareProfile_Changed"
                            ToolTip="Compatible mode conservatively disables optional Frame Generation and Neural Rendering while retaining supported Super Resolution."/>
                  <TextBlock Text="Uncheck Compatible mode to use Normal mode."
                             FontSize="11" Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap" Margin="0,0,0,14"/>
                  <Button Content="Refresh hardware detection"
                          HorizontalAlignment="Left" Style="{StaticResource CyanButton}"
                          ToolTip="Recheck your GPU, CPU, memory, NVIDIA driver and graphics API loaders without modifying drivers."
                          Click="RefreshHardwareProfile_Click"/>
                  <TextBlock x:Name="HardwareProfileStatusText"
                             Text="Hardware detection pending."
                             TextWrapping="Wrap" Foreground="{StaticResource Accent2}"
                             Margin="0,15,0,12"/>
                  <Border Background="#0B121A" BorderBrush="#1E2C3A"
                          BorderThickness="1" CornerRadius="9" Padding="12">
                    <TextBlock x:Name="HardwareDetailsText"
                               Text="No hardware scan completed yet."
                               TextWrapping="Wrap" FontSize="12"/>
                  </Border>
                  <TextBlock Margin="0,12,0,0"
                             Text="DirectX and Vulkan loader detection does not guarantee feature support. Game, driver and runtime compatibility are checked separately."
                             Foreground="{StaticResource Muted}" FontSize="10"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>