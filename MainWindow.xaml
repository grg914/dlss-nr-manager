              <Border Background="#0A1017"
                      BorderBrush="#1D2A39"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="7">
                <ListBox x:Name="PcUpdateList"
                         MinHeight="180"
                         MaxHeight="340"
