                          <ComboBoxItem Content="3×"/>
                          <ComboBoxItem Content="4×"/>
                        </ComboBox>
                      </StackPanel>

                      <StackPanel Grid.Column="2">
                        <TextBlock Text="AI model"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="AiModelBox" Margin="0,5,0,0" ToolTip="Choose an AI model suited to photographs, illustrations or video frames.">
                          <ComboBoxItem Content="General / Photo" IsSelected="True"/>
                          <ComboBoxItem Content="General / Conservative"/>
                          <ComboBoxItem Content="Illustration / Anime"/>
                          <ComboBoxItem Content="Anime Video / Minecraft"/>
