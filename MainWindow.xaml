                            Content="Neural Rendering"
                            Checked="PermanentVideoOption_Changed"
                            Unchecked="PermanentVideoOption_Changed"
                            Margin="0,0,0,4" ToolTip="Apply the available Neural Rendering processing stage to the exported video."/>

                  <CheckBox x:Name="PermanentArtifactReductionCheck"
