<Window x:Class="DlssNrManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DLSS NR Manager"
        Icon="assets/branding/logo.jpg"
        Width="1180" Height="900" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Bg}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#080B10" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <Grid Margin="12,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Image Width="26" Height="26" Source="assets/branding/logo.jpg"
               VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="1" Text="DLSS NR Manager"
                   VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="—" Width="44" Height="32" Padding="0" Margin="0"
                  Background="Transparent" BorderThickness="0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Minimize_Click"/>
          <Button Content="□" Width="44" Height="32" Padding="0" Margin="0"
                  Background="Transparent" BorderThickness="0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Maximize_Click"/>
          <Button Content="✕" Width="44" Height="32" Padding="0" Margin="0"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{StaticResource Danger}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="28">
        <StackPanel>
          <DockPanel Margin="0,0,0,22">
            <Border Width="74" Height="74" CornerRadius="18" Margin="0,0,18,0"
                    Background="{StaticResource Card}" ClipToBounds="True">
              <Image Source="assets/branding/logo.jpg" Stretch="UniformToFill"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="DLSS NR Manager" FontSize="34" FontWeight="SemiBold"/>
              <TextBlock Text="OptiScaler Neural Rendering manager for compatible installed games"
                         Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock x:Name="AppVersionText" Text="Version"
                           Foreground="{StaticResource Accent2}" FontSize="13" VerticalAlignment="Center"/>
                <Button x:Name="ManagerUpdateButton"
                        Content="Update available"
                        Visibility="Collapsed"
                        Padding="8,3" MinHeight="0"
                        Margin="12,0,0,0"
                        FontSize="12"
                        Click="ManagerUpdate_Click"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>

          <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                  BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Game target" FontSize="24" FontWeight="SemiBold"/>
                  <TextBlock x:Name="StatusText" Text="Scanning installed games…"
                             Foreground="{StaticResource Accent}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="Scan installed games" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Click="ScanGames_Click" Margin="12,0,0,0"/>
              </DockPanel>

              <TextBlock Text="Detected compatible games" Foreground="{StaticResource Muted}"/>
              <ComboBox x:Name="GameBox" Margin="0,6,0,12" Height="42"
                        MaxDropDownHeight="380"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="GameBox_SelectionChanged"/>

              <TextBlock x:Name="CompatibilityText" Foreground="{StaticResource Muted}"
                         TextWrapping="Wrap" Margin="0,0,0,14"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="Target executable folder" Foreground="{StaticResource Muted}"/>
                  <TextBox x:Name="GamePathBox" Margin="0,5,0,12" IsReadOnly="True"/>
                  <TextBlock Text="GPU" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="GpuText" Margin="0,4,0,7"/>
                  <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="RuntimeText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                  <Button Content="Select game folder" Click="SelectGame_Click" Margin="0,0,0,8"/>
                  <Button Content="Select DLSSNR runtime" Click="SelectRuntime_Click" Margin="0,0,0,8"/>
                  <TextBlock x:Name="RuntimePathText" TextWrapping="Wrap" Width="330"
                             Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                  BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="Release channel" FontSize="16" FontWeight="SemiBold"/>
                  <ComboBox x:Name="ChannelBox" Margin="0,10,0,6"
                            SelectionChanged="ChannelBox_SelectionChanged">
                    <ComboBoxItem Content="Stable" IsSelected="True"/>
                    <ComboBoxItem Content="Prerelease"/>
                  </ComboBox>
                  <TextBlock x:Name="AvailableVersionText" Foreground="{StaticResource Muted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="Neural Rendering preset" FontSize="16" FontWeight="SemiBold"/>
                  <ComboBox x:Name="PresetBox" Margin="0,10,0,6">
                    <ComboBoxItem Content="Quality — 100%" IsSelected="True"/>
                    <ComboBoxItem Content="Balanced — 75%"/>
                    <ComboBoxItem Content="Performance — 50%"/>
                  </ComboBox>
                  <TextBlock Text="1 pass • Natural style • universal compatible-game preset"
                             Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Grid>

              <WrapPanel Margin="0,20,0,0">
                <Button x:Name="InstallButton" Content="Install" Click="Install_Click"/>
                <Button x:Name="UpdateButton" Content="Update" Click="Install_Click"/>
                <Button x:Name="ApplyPresetButton" Content="Apply preset" Click="ApplyPreset_Click"/>
                <Button Content="Restore backup" Click="Restore_Click"/>
                <Button Content="Uninstall" Click="Uninstall_Click"/>
                <Button Content="Refresh" Click="Refresh_Click"/>
                <Button x:Name="DiagnoseButton" Content="Diagnose game" Click="Diagnose_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                  BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Compatibility diagnostics" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="DiagnosticText"
                         Text="Run Diagnose game to verify the renderer signals, OptiScaler load state, DLSSNR runtime and loader conflicts."
                         Foreground="{StaticResource Muted}"
                         TextWrapping="Wrap"
                         Margin="0,9,0,0"/>
            </StackPanel>
          </Border>

          <Expander Header="Advanced OptiScaler"
                    Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    Padding="20" Margin="0,0,0,14">
            <StackPanel Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,18,0">
                  <TextBlock Text="Proxy DLL" Foreground="{StaticResource Muted}"/>
                  <ComboBox x:Name="ProxyBox" Margin="0,5,0,12">
                    <ComboBoxItem Content="dbghelp.dll"/>
                    <ComboBoxItem Content="dxgi.dll" IsSelected="True"/>
                    <ComboBoxItem Content="d3d12.dll"/>
                  </ComboBox>

                  <TextBlock Text="FPS overlay" Foreground="{StaticResource Muted}"/>
                  <CheckBox x:Name="ShowFpsCheck" Content="Enable OptiScaler FPS overlay" IsChecked="True"/>

                  <TextBlock Text="FPS overlay detail" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                  <ComboBox x:Name="FpsTypeBox" Margin="0,5,0,12">
                    <ComboBoxItem Content="FPS only"/>
                    <ComboBoxItem Content="Simple — avg FPS + upscaler" IsSelected="True"/>
                    <ComboBoxItem Content="Frame time"/>
                    <ComboBoxItem Content="Upscaler time"/>
                    <ComboBoxItem Content="Detailed graph"/>
                    <ComboBoxItem Content="Full graph"/>
                    <ComboBoxItem Content="Reflex timings"/>
                  </ComboBox>

                  <TextBlock Text="FPS position" Foreground="{StaticResource Muted}"/>
                  <ComboBox x:Name="FpsPositionBox" Margin="0,5,0,12">
                    <ComboBoxItem Content="Top left" IsSelected="True"/>
                    <ComboBoxItem Content="Top right"/>
                    <ComboBoxItem Content="Bottom left"/>
                    <ComboBoxItem Content="Bottom right"/>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="Target process" Foreground="{StaticResource Muted}"/>
                  <TextBox x:Name="TargetProcessBox" Margin="0,5,0,12"
                           ToolTip="Leave empty to keep OptiScaler TargetProcessName=auto"/>

                  <TextBlock Text="Loader integration" Foreground="{StaticResource Muted}"/>
                  <CheckBox x:Name="LoadReShadeCheck" Content="Ask OptiScaler to load ReShade64.dll"/>

                  <Button Content="Apply advanced settings" Click="ApplyAdvanced_Click"
                          HorizontalAlignment="Left" Margin="0,14,0,0"/>

                  <TextBlock Margin="0,14,0,0"
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             Text="F10 opens the OptiScaler menu. dxgi.dll is the generic first choice; Cyberpunk 2077 uses dbghelp.dll as its validated recommendation. TargetProcessName can prevent injection into launchers and helper processes."/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Expander>

          <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                  BorderThickness="1" CornerRadius="16" Padding="20">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <TextBlock Text="OptiScaler log" FontSize="16" FontWeight="SemiBold"/>
                <Button Content="Reload log" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Click="ReloadLog_Click"/>
              </DockPanel>
              <TextBox x:Name="LogBox" Height="260" IsReadOnly="True" TextWrapping="NoWrap"
                       FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>