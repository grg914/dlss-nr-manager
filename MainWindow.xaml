                    <DataTemplate>
                      <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="185"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Kind}"
                                   Foreground="{StaticResource Accent2}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,12,0">
                          <TextBlock Text="{Binding Name}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"/>
                          <TextBlock Foreground="{StaticResource Muted}"
                                     FontSize="11"
                                     TextWrapping="Wrap">
                            <Run Text="{Binding CurrentVersion}"/>
                            <Run Text="  →  "/>
                            <Run Text="{Binding AvailableVersion}"/>
                            <Run Text="  •  "/>
                            <Run Text="{Binding Source}"/>
                          </TextBlock>
                          <TextBlock Text="{Binding Details}"
                                     Foreground="{StaticResource Muted}"
                                     FontSize="10"
                                     TextWrapping="Wrap"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding ActionLabel}"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
