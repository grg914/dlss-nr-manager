                                Margin="24,5,0,10"
                                SelectedIndex="1" ToolTip="Choose the video export scaling factor; higher values take longer.">
                        <ComboBoxItem Content="x1 — résolution native"/>
                        <ComboBoxItem Content="x2 — upscale IA 2×"/>
                        <ComboBoxItem Content="x4 — upscale IA 4×"/>
