<!--
DLSS NR Manager — WinToys navigation mockup
Prototype only. Intended structure for migration of current MainWindow.xaml.
All currently exposed functional areas are represented as navigation destinations.
-->
<Window x:Class="DlssNrManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DLSS NR Manager"
        Width="1420" Height="920"
        MinWidth="1120" MinHeight="760"
        Background="#070B10"
        Foreground="#F2F6FB"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#060A0F"
            BorderBrush="#172433" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="9" Background="#1AAE61"/>
          <TextBlock Text="DLSS NR Manager" FontWeight="SemiBold" FontSize="16"
                     Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#080D13"
            BorderBrush="#172433" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,14">
          <TextBlock Text="PRINCIPAL" Foreground="#6F86A0" FontSize="10" Margin="12,8,0,6"/>
          <Button Content="🎮  Jeux &amp; DLSS" Height="40"/>
          <Button Content="⛏️  Minecraft RTX" Height="40"/>

          <TextBlock Text="MEDIA" Foreground="#6F86A0" FontSize="10" Margin="12,18,0,6"/>
          <Button Content="✨  Media Neural" Height="40"/>
          <Button Content="◉  Détection IA" Height="40"/>

          <TextBlock Text="SYSTÈME" Foreground="#6F86A0" FontSize="10" Margin="12,18,0,6"/>
          <Button Content="↻  PC Update Center" Height="40"/>
          <Button Content="🧹  PC Cleanup" Height="40"/>
          <Button Content="⌁  Diagnostics" Height="40"/>

          <TextBlock Text="EXPERT" Foreground="#6F86A0" FontSize="10" Margin="12,18,0,6"/>
          <Button Content="⚙  Advanced OptiScaler" Height="40"/>
          <Button Content="▤  OptiScaler log" Height="40"/>

          <Separator Margin="0,14"/>
          <Button Content="☰  Application" Height="40"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Margin="26">
      <!--
      Replace with ContentControl / DataTemplate pages.
      Page inventory, mapped 1:1 to current controls:

      JEUX & DLSS
      - AppVersionText / GpuText / GpuCompatibilityText
      - GameBox / StatusText / CompatibilityText / SelectGame
      - GamePathBox / VersionText / RuntimeText
      - SelectRuntimeButton / DiagnoseButton / AutoNvidiaRuntimeCheck / RuntimePathText
      - ChannelBox: Stable / Prerelease
      - PresetBox: Quality 100 / Balanced 75 / Performance 50
      - AutoNvidiaResourcesCheck / GameSafetyText
      - Install / Update / Apply preset / Restore backup / Uninstall / Refresh

      MINECRAFT RTX
      - MinecraftInstanceBox / Scan / Choose folder
      - Preflight + details
      - Fabric API
      - Latest tested Caustica RTX 26.2 build
      - Performance pack: Lithium + FerriteCore + Krypton + C2ME + BadOptimizations + Dynamic FPS
      - SPBR LabPBR
      - Install DLSS / RTX / Restore original / Open Launcher
      - MinecraftDlssZipBox / Select DLSS ZIP
      - MinecraftDlssNrBox / Select DLSSNR DLL
      - Check NVIDIA files
      - DLSS SR / FG / Reflex / NR selectors
      - Stage DLSS package / Stage DLSSNR only / Clear staged runtime

      MEDIA NEURAL
      - Mode: NR / AI Upscale / NR + AI Upscale
      - source / output directory
      - output size: Native / 2x / 4K
      - style: Default / Natural / Cinematic
      - intensity slider
      - AI scale: 2x / 3x / 4x
      - model: General Photo / Conservative / Illustration Anime / Anime Video Minecraft
      - tile: Auto / 256 / 384 / 512
      - TTA
      - Set up AI Upscale
      - Set up media engine / Process media

      AI ORIGIN
      - Set up detector
      - Analyze selected media
      - status / result details

      PC UPDATE CENTER
      - Scan PC updates
      - WinGet update all
      - Clear scan cache
      - update list / selection text / Open official page

      PC CLEANUP
      - Analyze caches / Clean selected
      - user temp / Windows Temp / D3DSCache / NVIDIA DXCache / GLCache / NV_Cache
      - analyzed total

      DIAGNOSTICS
      - DiagnosticText
      - game diagnosis results

      ADVANCED OPTISCALER
      - ProxyBox: dbghelp / dxgi / d3d12
      - Show FPS
      - FPS detail: FPS only / Simple / Detailed / Detailed+graph / Full / Full+graph / Reflex timings
      - position: TL / TR / BL / BR
      - TargetProcessBox
      - LoadReShadeCheck
      - InstallReShadeAddonCheck
      - AutoUpdateComponentsCheck
      - Install ReShade add-on
      - Check component updates
      - Apply advanced settings

      LOGS
      - LogBox
      - Reload log
      - Open diagnostic logs

      APPLICATION
      - Manager update
      - Scan installed games
      - Clear cover cache
      - Open diagnostic logs
      - Delete local app data
      -->
      <Border CornerRadius="16" BorderBrush="#26374A" BorderThickness="1"
              Background="#0D141D" Padding="24">
        <StackPanel>
          <TextBlock Text="Prototype de navigation WinToys"
                     FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="Tous les contrôles actuellement exposés dans MainWindow.xaml sont mappés dans les pages du menu latéral."
                     Foreground="#93A8C3" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="Utilise la maquette HTML complète pour la prévisualisation interactive."
                     Foreground="#2CC9FF" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
