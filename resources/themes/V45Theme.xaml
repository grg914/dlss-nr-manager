<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Reference palette. Merge selected keys only; avoid replacing existing app resources. -->
    <Color x:Key="V45.WindowColor">#07111E</Color>
    <Color x:Key="V45.SidebarColor">#091521</Color>
    <Color x:Key="V45.PanelColor">#10263A</Color>
    <Color x:Key="V45.CardColor">#11283B</Color>
    <Color x:Key="V45.BorderColor">#284159</Color>
    <Color x:Key="V45.TextColor">#F0F7FF</Color>
    <Color x:Key="V45.MutedColor">#A9C1D3</Color>
    <Color x:Key="V45.GreenColor">#68F274</Color>
    <Color x:Key="V45.BlueColor">#3D98FF</Color>
    <Color x:Key="V45.PurpleColor">#A481FF</Color>
    <SolidColorBrush x:Key="V45.WindowBrush" Color="{StaticResource V45.WindowColor}"/>
    <SolidColorBrush x:Key="V45.SidebarBrush" Color="{StaticResource V45.SidebarColor}"/>
    <SolidColorBrush x:Key="V45.PanelBrush" Color="{StaticResource V45.PanelColor}"/>
    <SolidColorBrush x:Key="V45.CardBrush" Color="{StaticResource V45.CardColor}"/>
    <SolidColorBrush x:Key="V45.TextBrush" Color="{StaticResource V45.TextColor}"/>
    <SolidColorBrush x:Key="V45.MutedBrush" Color="{StaticResource V45.MutedColor}"/>
    <SolidColorBrush x:Key="V45.AccentGreenBrush" Color="{StaticResource V45.GreenColor}"/>
    <SolidColorBrush x:Key="V45.AccentBlueBrush" Color="{StaticResource V45.BlueColor}"/>
    <SolidColorBrush x:Key="V45.AccentPurpleBrush" Color="{StaticResource V45.PurpleColor}"/>
    <Style x:Key="V45.PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource V45.CardBrush}"/>
        <Setter Property="BorderBrush" Value="#284159"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="V45.CardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource V45.TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="V45.CaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource V45.MutedBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
</ResourceDictionary>
