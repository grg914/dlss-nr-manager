<Application x:Class="DlssNrManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0B0D10"/>
    <SolidColorBrush x:Key="Card" Color="#151922"/>
    <SolidColorBrush x:Key="Card2" Color="#1C2230"/>
    <SolidColorBrush x:Key="Text" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="Accent" Color="#55F07A"/>
    <SolidColorBrush x:Key="Accent2" Color="#35CFF2"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5A64"/>
    <SolidColorBrush x:Key="Border" Color="#263342"/>

    <!-- Override native Windows theme colors used internally by WPF ComboBox/Button templates. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#101722"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#151922"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#174B37"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#748091"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="{StaticResource Card2}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#253143"/>
          <Setter Property="BorderBrush" Value="#35506A"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#10141B"/>
          <Setter Property="Foreground" Value="#748091"/>
          <Setter Property="BorderBrush" Value="#202A36"/>
          <Setter Property="Cursor" Value="Arrow"/>
          <Setter Property="Opacity" Value="1"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0F131A"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="SelectionBrush" Value="#4060A0"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#101722"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#748091"/>
          <Setter Property="Background" Value="#10141B"/>
          <Setter Property="Opacity" Value="1"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#101722"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="10,7"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#174B37"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1B2C3B"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,4,16,4"/>
    </Style>
  </Application.Resources>
</Application>