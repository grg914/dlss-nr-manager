<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DlssNrManager</AssemblyName>
    <RootNamespace>DlssNrManager</RootNamespace>
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <InformationalVersion>3.2.0</InformationalVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>assets\branding\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs;third_party\**\*.cs;third_party-local\**\*.cs;Caustica-RTX\**\*.cs" />
    <Page Remove="third_party\**\*.xaml;third_party-local\**\*.xaml;Caustica-RTX\**\*.xaml" />
    <ApplicationDefinition Remove="third_party\**\*.xaml;third_party-local\**\*.xaml;Caustica-RTX\**\*.xaml" />
    <EmbeddedResource Remove="tests\**\*;third_party\**\*;third_party-local\**\*;Caustica-RTX\**\*" />
    <Content Remove="third_party\**\*;third_party-local\**\*;Caustica-RTX\**\*" />
    <None Remove="tests\**\*;third_party\**\*;third_party-local\**\*;Caustica-RTX\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="assets\branding\logo.png" />
    <Resource Include="assets\branding\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Documentation prototypes must never be compiled as WPF Pages. -->
    <Page Remove="docs\mockups\**\*.xaml" />
    <None Include="docs\mockups\**\*.xaml" />
    <None Include="docs\mockups\**\*.html" />
  </ItemGroup>

  <Target Name="GenerateApplicationIcon"
          BeforeTargets="CoreCompile"
          Condition="'$(OS)' == 'Windows_NT' and Exists('$(MSBuildProjectDirectory)\assets\branding\logo.png')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Generate-AppIcon.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\assets\branding\logo.png&quot; -Output &quot;$(MSBuildProjectDirectory)\assets\branding\app.ico&quot;" />
  </Target>
</Project>