<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DlssNrManager</AssemblyName>
    <RootNamespace>DlssNrManager</RootNamespace>
    <Version>0.8.1</Version>
    <AssemblyVersion>0.8.1.0</AssemblyVersion>
    <FileVersion>0.8.1.0</FileVersion>
    <InformationalVersion>0.8.1</InformationalVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>assets\branding\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\branding\logo.png" />
    <Resource Include="assets\branding\app.ico" />
  </ItemGroup>

  <Target Name="GenerateApplicationIcon"
          BeforeTargets="CoreCompile"
          Condition="'$(OS)' == 'Windows_NT' and Exists('$(MSBuildProjectDirectory)\assets\branding\logo.png')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Generate-AppIcon.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\assets\branding\logo.png&quot; -Output &quot;$(MSBuildProjectDirectory)\assets\branding\app.ico&quot;" />
  </Target>
</Project>